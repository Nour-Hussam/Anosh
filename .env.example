# ============================================================
#  Kingdom Journeys — environment configuration
#  Copy this file to `.env` and fill in the values.
#  Never commit the real `.env` (it is git-ignored).
# ============================================================

# --- Runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public origin of the site (used for absolute links in emails).
BASE_URL=http://localhost:3000

# Set to 1 (or true) when running behind a reverse proxy (nginx, Caddy, Cloudflare...).
# It makes Express read the real client IP from X-Forwarded-For and mark cookies secure.
TRUST_PROXY=0

# SameSite policy for the session / CSRF / visitor cookies.
#   auto   (default) → Lax, except HTTPS requests outside production (hosted previews
#                      embed the app in a frame, where browsers drop Lax cookies)
#   lax / strict     → always that policy (strict is safest, breaks the embedded case)
#   none             → always None + Secure; enable this when the dashboard is embedded
#                      in another site in production (the app falls back to Lax if the
#                      request did not arrive over HTTPS, because browsers reject
#                      "None" without "Secure").
COOKIE_SAMESITE=auto
# Force the Secure flag on cookies. Defaults to true in production and is also set
# automatically whenever the request arrives over HTTPS.
# COOKIE_SECURE=true

# --- Database ---
# Relative paths are resolved from the project root.
DATABASE_FILE=data/kingdom-journeys.db

# --- Security (REQUIRED in production) ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Secret used to HMAC the CSRF double-submit cookie.
CSRF_SECRET=
# Secret used to hash stored IPs (privacy preserving).
IP_HASH_SALT=

# Admin session lifetime
SESSION_TTL_MINUTES=120
SESSION_IDLE_MINUTES=45

# Brute-force protection for the admin login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- First admin account (created once, on first boot / seed) ---
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@kingdom-journeys.local
# Must be at least 12 characters in production.
ADMIN_PASSWORD=ChangeMe-Now!123

# --- Mail (optional) ---
# Leave SMTP_HOST empty and notifications are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kingdom Journeys <no-reply@kingdom-journeys.sa>"
MAIL_TO=bookings@kingdom-journeys.sa

# --- Rate limiting overrides (optional) ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
